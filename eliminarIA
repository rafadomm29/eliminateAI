  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', ui-sans-serif, system-ui;
      background: #f8fafc;
      color: #1e293b;
    }

    /* Fondo de puntos sutil */
    .bg-dots {
      background-color: #f8fafc;
      background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
      background-size: 24px 24px;
    }

    /* Avatar ring pulsante */
    .avatar-ring {
      animation: pulse2 2.5s ease-in-out infinite;
    }
    @keyframes pulse2 {
      0%, 100% { box-shadow: 0 0 0 0 rgba(14,165,233,0.4); }
      50%       { box-shadow: 0 0 0 12px rgba(14,165,233,0); }
    }

    /* Cards con elevación */
    .card {
      transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1),
                  box-shadow 0.25s ease,
                  background-color 0.2s ease,
                  border-color 0.2s ease,
                  color 0.2s ease;
    }
    .card:hover {
      transform: translateY(-6px) scale(1.015);
    }

    /* Badges con escala */
    .badge {
      transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .badge:hover { transform: scale(1.08); }

    /* Botones sociales en footer */
    .social-btn {
      transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1),
                  background-color 0.2s ease,
                  color 0.2s ease;
    }
    .social-btn:hover { transform: translateY(-3px) scale(1.12); }

    /* Animaciones escalonadas hero */
    .anim-1 { animation: fadeUp 0.65s 0.05s ease both; }
    .anim-2 { animation: fadeUp 0.65s 0.18s ease both; }
    .anim-3 { animation: fadeUp 0.65s 0.32s ease both; }
    .anim-4 { animation: fadeUp 0.65s 0.46s ease both; }
    .anim-5 { animation: fadeUp 0.65s 0.60s ease both; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(32px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Gradiente hero */
    .hero-gradient {
      background: linear-gradient(135deg, #e0f2fe 0%, #ede9fe 50%, #f0f9ff 100%);
    }

    /* Divisor animado */
    .section-divider {
      height: 3px;
      border-radius: 9999px;
      background: linear-gradient(90deg, #0ea5e9, #6366f1, #0ea5e9);
      background-size: 200% 100%;
      animation: shimmer 3s linear infinite;
    }
    @keyframes shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Nav link underline hover */
    .nav-link {
      position: relative;
      transition: color 0.2s;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -2px; left: 0;
      width: 0; height: 2px;
      background: #0ea5e9;
      border-radius: 2px;
      transition: width 0.25s ease;
    }
    .nav-link:hover::after { width: 100%; }
    .nav-link:hover { color: #0ea5e9; }
  </style>
</head>

